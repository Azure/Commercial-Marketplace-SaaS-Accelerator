<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
   <title>Neumo STR</title>
    <link rel="icon" type="image/png" href="~/images/neumo-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/customer-site.css" />
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <link href="~/lib/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/font-awesome/css/font-awesome.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/customer-custom.css" />
    <link rel="stylesheet" href="~/css/neumo-customer.css" asp-append-version="true" />
    <link href="~/lib/bootstrap/customer-offcanvas.css" rel="stylesheet" />
    
</head>
<body class="neumo-body">
        <header class="neumo-portal-topbar">
        <div class="neumo-portal-wrap">
            <div class="neumo-portal-brand">
                <a  asp-controller="Home" asp-action="Index" aria-label="Neumo home">
                    <img class="neumo-portal-logo" src="~/images/neumo-dark-logo.png" alt="neumo" />
                </a>
                <span class="neumo-portal-product">Short Term Rental</span>
            </div>
            <div class="neumo-portal-user">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span>@User.Identity.Name</span>
                    <span class="neumo-divider" aria-hidden="true"></span>
                    <a asp-controller="Account" asp-action="SignOut" aria-label="Sign out" title="Sign out">
                        <i class="fa fa-sign-out" aria-hidden="true"></i>
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="SignIn">Sign in</a>
                }
            </div>
        </div>
    </header>
    <nav class="neumo-portal-breadcrumb" aria-label="Primary">
        <div class="neumo-portal-wrap">
            @{
                var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
                var isHome = string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);
                var isSubscriptions = string.Equals(currentAction, "Subscriptions", StringComparison.OrdinalIgnoreCase);
            }
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="@(isHome ? "neumo-nav-current" : null)"
                   asp-controller="Home"
                   asp-action="Index">Home</a>
                <a class="@(isSubscriptions ? "neumo-nav-current" : (isHome ? "neumo-nav-muted" : null))"
                   asp-controller="Home"
                   asp-action="Subscriptions">Subscriptions</a>
            }
            else
            {
                <a class="neumo-nav-current" asp-controller="Home" asp-action="Index">Home</a>
            }
        </div>
    </nav>
   
    <div class="container pb-3">
        <partial name="_CookieConsentPartial" />
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="neumo-footer">
        <div class="neumo-wrap">
            <img class="neumo-logo-img" src="~/images/neumo-logo.png" alt="neumo" />
            <span class="neumo-footer-copy">&copy; @DateTime.UtcNow.Year neumo. Serving Governments That Transform Communities.</span>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="~/lib/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
    <script src="~/js/script.js"></script>
    <script src="https://cdn.datatables.net/1.10.20/js/jquery.dataTables.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/offcanvas.js"></script>
    
    @RenderSection("Scripts", required: false)
</body>
</html>
