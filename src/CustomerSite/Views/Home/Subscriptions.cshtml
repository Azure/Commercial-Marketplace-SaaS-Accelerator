@using Marketplace.SaaS.Accelerator.Services.Models
@model Marketplace.SaaS.Accelerator.Services.Models.SubscriptionViewModel
@{
    ViewData["Title"] = "Subscriptions";
}

<div class="neumo-wrap-wide">
    @if (!Model.IsSuccess && !string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <strong>Error!</strong> @Model.ErrorMessage
        </div>
    }

    <form method="post">
        @Html.AntiForgeryToken()

        <h1 class="neumo-page-title">Subscriptions</h1>

        <div class="neumo-logo-banner">
            <img class="neumo-logo-img" src="~/images/neumo-str-logo.png" alt="neumo Short Term Rental" />
        </div>

        @if (Model.Subscriptions.Count() > 0)
        {
            <div class="table-responsive">
                <table id="table" class="table table-bordered dt-responsive neumo-subscriptions-table cm-table">
                    <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Offer</th>
                            <th scope="col">Plan</th>
                            <th scope="col">Quantity</th>
                            <th scope="col">Status</th>
                            <th scope="col">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Subscriptions.Count; i++)
                        {
                            var subscription = Model.Subscriptions[i];
                            <tr>
                                <td>
                                    @Html.HiddenFor(s => s.Subscriptions[i].Id)
                                    @Html.HiddenFor(s => s.Subscriptions[i].PlanId)
                                    <span class="neumo-name-text">@subscription.Name</span>
                                </td>
                                <td><span class="neumo-mono-value">@subscription.OfferId</span></td>
                                <td><span class="neumo-mono-value">@subscription.PlanId</span></td>
                                <td>
                                    @if (subscription.IsPerUserPlan)
                                    {
                                        @subscription.Quantity
                                    }
                                    else
                                    {
                                        <span>N/A</span>
                                    }
                                </td>
                                <td><span class="neumo-mono-value">@subscription.SubscriptionStatus</span></td>
                                <td class="cm-ellipsis">
                                    <div class="nav-item dropdown">
                                        <a class="nav-link dropdown cm-link-button" href="#" id="subscription-actions-@i" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false"  aria-label="Subscription actions for @subscription.Name">  <i class="fa fa-bars" aria-hidden="true"></i></a>
                                        <div class="dropdown-menu dropdown-menu-end" aria-labelledby="subscription-actions-@i">
                                            @if (subscription.SubscriptionStatus == SubscriptionStatusEnumExtension.Subscribed)
                                            {
                                                <a class="dropdown-item cm-dropdown-option" asp-action="ViewSubscription" asp-route-subscriptionId="@Model.Subscriptions[i].Id" asp-route-planId="@Model.Subscriptions[i].PlanId" asp-route-operation="Deactivate">Unsubscribe</a>
                                                @if (subscription.AcceptSubscriptionUpdates == true)
                                                {
                                                    <a class="dropdown-item cm-dropdown-option" href="#" onclick="ViewSubscriptionDetail('@Model.Subscriptions[i].Id'); return false;" data-bs-toggle="modal" data-bs-target="#myModal">Change Plan</a>
                                                    @if (subscription.IsPerUserPlan)
                                                    {
                                                        <a class="dropdown-item cm-dropdown-option" href="#" onclick="ViewSubscriptionQuantityDetail('@Model.Subscriptions[i].Id'); return false;" data-bs-toggle="modal" data-bs-target="#myModal">Change Quantity</a>
                                                    }
                                                    <a class="dropdown-item cm-dropdown-option" target="_blank" rel="noopener noreferrer" href="@Model.SaaSAppUrl" title="Click here to go to SaaS App">SaasApp</a>
                                                }
                                            }
                                            @if (subscription.SubscriptionStatus == SubscriptionStatusEnumExtension.PendingFulfillmentStart && subscription.IsAutomaticProvisioningSupported == true)
                                            {
                                                <a class="dropdown-item cm-dropdown-option" asp-action="ViewSubscription" asp-route-subscriptionId="@Model.Subscriptions[i].Id" asp-route-planId="@Model.Subscriptions[i].PlanId" asp-route-operation="Activate">Activate</a>
                                            }
                                            @if (subscription.SubscriptionStatus == SubscriptionStatusEnumExtension.PendingFulfillmentStart && subscription.IsAutomaticProvisioningSupported == false)
                                            {
                                                <a class="dropdown-item cm-dropdown-option" asp-action="ViewSubscription" asp-route-subscriptionId="@Model.Subscriptions[i].Id" asp-route-planId="@Model.Subscriptions[i].PlanId" asp-route-operation="Activate">Subscribe</a>
                                            }
                                            <a class="dropdown-item cm-dropdown-option" href="#" data-bs-toggle="modal" data-bs-target="#myModal" onclick="ViewSubscriptionlogdetailsById('@Model.Subscriptions[i].Id'); return false;">Activity Log</a>


                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="cm-panel-default mt40">
                <div class="p-3">
                    <p>
                        You do not have subscriptions yet. Please purchase the offer from <a href="https://portal.azure.com/" target="_blank" rel="noopener noreferrer">Azure</a>.
                    </p>
                </div>
            </div>
        }

        <div class="modal" id="myModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="exampleModalLabel">Modal title</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    function ViewSubscriptionQuantityDetail(subscriptionId) {
        $.ajax({
            type: "Get",
            url: "SubscriptionQuantityDetail",
            data: { subscriptionId: subscriptionId },
            contentType: "application/json; charset=utf-8",
            datatype: "json",
            success: function (data) {
                $('#myModal').html(data);
                $('#myModal').modal();
            },
            error: function () {
                swal({
                    title: "Error",
                    text: "Content load failed.",
                    icon: "Error"
                })
            }
        });
    }
    function ViewSubscriptionDetail(subscriptionId) {
        $.ajax({
            type: "Get",
            url: "SubscriptionDetail",
            data: { subscriptionId: subscriptionId },
            contentType: "application/json; charset=utf-8",
            datatype: "json",
            success: function (data) {
                $('#myModal').html(data);
                $('#myModal').modal();
            },
            error: function () {
                swal({
                    title: "Error",
                    text: "Content load failed.",
                    icon: "Error"
                })
            }
        });
    }
    function ViewSubscriptionlogdetailsById(subscriptionId) {
        $.ajax({
            type: "Get",
            url: "SubscriptionLogDetail",
            data: { subscriptionId: subscriptionId },
            contentType: "application/json; charset=utf-8",
            datatype: "json",
            success: function (data) {
                $('#myModal').html(data);
                $('#myModal').modal();
            },
            error: function () {
                swal({
                    title: "Error",
                    text: "Content load failed.",
                    icon: "Error"
                })
            }
        });
    }

    function confirmDialog() {
        var newPlanName = $('#PlanId').val();
        swal({
            text: "Are you sure you want to switch to " + newPlanName + " plan?",
            icon: "warning",
            buttons: true,
            dangerMode: true,
        })
            .then((willChange) => {
                if (willChange) {
                    $("#frmButton").prop("disabled", true);
                    $("#frmSpinner").prop("hidden", false);
                    $("#frmSubscriptionDetail").submit();
                }
            });
    }

    function confirmQuantityDialog() {
        var newQuantity = $('#Quantity').val();
        swal({
            text: "Are you sure you want to Change the quantity to " + newQuantity + "?",
            icon: "warning",
            buttons: true,
            dangerMode: true,
        })
            .then((willChange) => {
                if (willChange) {
                    $("#frmButton").prop("disabled", true);
                    $("#frmSpinner").prop("hidden", false);
                    $("#frmSubscriptionQuantityDetail").submit();
                }
            });
    }
</script>